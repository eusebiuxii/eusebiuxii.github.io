---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ContentBrowser from "@/components/ContentBrowser/ContentBrowser"
import PageHeader from "@/components/PageHeader/PageHeader.astro"
import { getItems } from "@/lib/content"

const items = await getItems(["projects"])
---

<BaseLayout title="Projects" description="Things I've built.">
  <div class="container">
    <ContentBrowser
      client:load
      collapsible
      items={items}
      placeholder="Search projects…"
    >
      <PageHeader
        title="Projects"
        description="Things I've built, big and small."
      />
    </ContentBrowser>
  </div>
</BaseLayout>
