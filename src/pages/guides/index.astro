---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ContentBrowser from "@/components/ContentBrowser/ContentBrowser"
import PageHeader from "@/components/PageHeader/PageHeader.astro"
import { getItems } from "@/lib/content"

const items = await getItems(["guides"])
---

<BaseLayout title="Guides" description="Tutorials and how-tos.">
  <div class="container">
    <ContentBrowser
      client:load
      collapsible
      items={items}
      placeholder="Search guides…"
    >
      <PageHeader
        title="Guides"
        description="Tutorials and how-tos — written so you don't have to figure it out the hard way."
      />
    </ContentBrowser>
  </div>
</BaseLayout>
