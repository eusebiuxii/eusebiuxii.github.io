---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import styles from "./Carousel.module.css"

/**
 * An image strip for MDX pages. It fills the content width and shows as
 * many images as fit, at a fixed height. The selected image gets an accent
 * border and is brought to the middle (the first stays on the left and the
 * last on the right). Edges fade out when there's more to scroll to.
 *
 * Swiping works on its own (CSS scroll snapping); the script adds the
 * selection, arrows, dots and keyboard control.
 */
interface Props {
  /** What the images show, read out by screen readers */
  label: string
  images: { src: ImageMetadata; alt: string; caption?: string }[]
  /**
   * Height of every image, as any CSS length. Widths follow each image's
   * shape. Defaults to the --slide-height in Carousel.module.css.
   */
  height?: string
}

const { label, images, height } = Astro.props
---

<section
  class={styles.carousel}
  aria-roledescription="carousel"
  aria-label={label}
  style={height ? `--slide-height: ${height}` : undefined}
  data-carousel
>
  <div class={styles.viewport}>
    <div class={styles.track} tabindex="0" data-track>
      {
        images.map((image, i) => (
          <figure
            class={styles.slide}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${images.length}`}
            data-caption={image.caption ?? ""}
          >
            <Image
              src={image.src}
              alt={image.alt}
              widths={[400, 800]}
              sizes="(max-width: 40rem) 70vw, 20rem"
              loading={i < 3 ? "eager" : "lazy"}
            />
          </figure>
        ))
      }
    </div>

    <button
      class={`${styles.arrow} ${styles.prev}`}
      type="button"
      aria-label="Previous image"
      data-prev
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="m15 18-6-6 6-6"></path></svg
      >
    </button>
    <button
      class={`${styles.arrow} ${styles.next}`}
      type="button"
      aria-label="Next image"
      data-next
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="m9 18 6-6-6-6"></path></svg
      >
    </button>
  </div>

  <div class={styles.footer}>
    <p class={styles.caption} aria-live="polite" data-caption-text>
      {images[0]?.caption}
    </p>
    <div class={styles.dots} data-dots hidden>
      {
        images.map((_, i) => (
          <button
            class={styles.dot}
            type="button"
            aria-label={`Show image ${i + 1}`}
            aria-current={i === 0 ? "true" : undefined}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

  function setUp(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-track]")!
    const slides = [...track.children] as HTMLElement[]
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!
    const next = root.querySelector<HTMLButtonElement>("[data-next]")!
    const dotsBox = root.querySelector<HTMLElement>("[data-dots]")!
    const dots = [...dotsBox.children] as HTMLButtonElement[]
    const caption = root.querySelector<HTMLElement>("[data-caption-text]")!

    if (slides.length === 0) return
    if (slides.length > 1) prev.hidden = next.hidden = dotsBox.hidden = false

    let current = 0
    // True while a scroll we started is running, so it doesn't change the
    // selection (at the ends the selected image can't reach the middle)
    let ourScroll = false
    let settleTimer = 0

    const maxScroll = () => track.scrollWidth - track.clientWidth

    /** Fade an edge only when there's more to scroll to on that side */
    const updateFades = () => {
      track.toggleAttribute("data-fade-start", track.scrollLeft > 1)
      track.toggleAttribute("data-fade-end", track.scrollLeft < maxScroll() - 1)
    }

    /** Scroll position that puts a slide in the middle (browser clamps it) */
    const centreOf = (slide: HTMLElement) =>
      slide.offsetLeft + slide.offsetWidth / 2 - track.clientWidth / 2

    const select = (i: number) => {
      current = Math.max(0, Math.min(slides.length - 1, i))
      slides.forEach((slide, s) =>
        slide.toggleAttribute("data-selected", s === current)
      )
      dots.forEach((dot, d) =>
        d === current
          ? dot.setAttribute("aria-current", "true")
          : dot.removeAttribute("aria-current")
      )
      prev.disabled = current === 0
      next.disabled = current === slides.length - 1
      caption.textContent = slides[current].dataset.caption ?? ""
    }

    const goTo = (i: number, smooth = true) => {
      select(i)
      ourScroll = true
      track.scrollTo({
        left: Math.max(0, Math.min(maxScroll(), centreOf(slides[current]))),
        behavior: smooth && !reducedMotion.matches ? "smooth" : "auto",
      })
    }

    /** After a swipe, select the image nearest the middle (or an end one) */
    const selectFromScroll = () => {
      if (track.scrollLeft <= 1) return select(0)
      if (track.scrollLeft >= maxScroll() - 1) return select(slides.length - 1)
      const middle = track.scrollLeft + track.clientWidth / 2
      let nearest = 0
      slides.forEach((slide, s) => {
        const distance = (el: HTMLElement) =>
          Math.abs(el.offsetLeft + el.offsetWidth / 2 - middle)
        if (distance(slide) < distance(slides[nearest])) nearest = s
      })
      select(nearest)
    }

    // "scrollend" isn't everywhere yet, so a short pause counts as the end
    const onScrollEnd = () => {
      if (ourScroll) ourScroll = false
      else selectFromScroll()
    }
    track.addEventListener("scroll", () => {
      updateFades()
      clearTimeout(settleTimer)
      settleTimer = window.setTimeout(onScrollEnd, 120)
    })

    prev.addEventListener("click", () => goTo(current - 1))
    next.addEventListener("click", () => goTo(current + 1))
    dots.forEach((dot, d) => dot.addEventListener("click", () => goTo(d)))
    slides.forEach((slide, s) => slide.addEventListener("click", () => goTo(s)))

    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goTo(current - 1)
      else if (event.key === "ArrowRight") goTo(current + 1)
      else return
      event.preventDefault()
    })

    // Keep things lined up when the width changes (e.g. rotating a phone)
    new ResizeObserver(() => {
      goTo(current, false)
      updateFades()
    }).observe(track)

    select(0)
    updateFades()
  }

  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((root) => setUp(root))
</script>
