---
import styles from "./AiNotice.module.css"

/** Disclosure shown at the top of entries that were built with AI help */
---

<aside class={styles.notice} aria-label="AI disclosure">
  <span class={styles.icon} aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
      <path
        d="M11 2.5c.4 3.9 2.6 6.1 6.5 6.5-3.9.4-6.1 2.6-6.5 6.5-.4-3.9-2.6-6.1-6.5-6.5 3.9-.4 6.1-2.6 6.5-6.5Z"
      ></path>
      <path
        d="M18.5 13.5c.2 1.9 1.1 2.8 3 3-1.9.2-2.8 1.1-3 3-.2-1.9-1.1-2.8-3-3 1.9-.2 2.8-1.1 3-3Z"
      ></path>
    </svg>
  </span>
  <div class={styles.body}>
    <p class={styles.label}>AI-assisted</p>
    <p class={styles.text}>
      This project was built with the help of Claude, an AI assistant.
    </p>
  </div>
</aside>
