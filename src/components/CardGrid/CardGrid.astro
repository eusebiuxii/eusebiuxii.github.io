---
import styles from "./CardGrid.module.css"

interface Props {
  /**
   * Show only this many cards on phone-sized screens (one column); the rest
   * are hidden there and shown on wider screens. Supports 1 to 6.
   */
  mobileLimit?: 1 | 2 | 3 | 4 | 5 | 6
}

const { mobileLimit } = Astro.props
---

<div class={styles.grid} data-mobile-limit={mobileLimit}>
  <slot />
</div>
