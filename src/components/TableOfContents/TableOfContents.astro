---
import type { MarkdownHeading } from "astro"
import { cn } from "@/lib/utils"
import styles from "./TableOfContents.module.css"

interface Props {
  /** From `render(entry)`; Astro gives each Markdown heading a slug id */
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
---

<ul class={styles.list}>
  {
    headings.map((heading) => (
      <li>
        <a
          class={cn(styles.link, heading.depth > 2 && styles.nested)}
          href={`#${heading.slug}`}
          data-toc-link={heading.slug}
        >
          {heading.text}
        </a>
      </li>
    ))
  }
</ul>

<script>
  /*
   * Scroll spy: highlights the section currently being read. A heading is
   * "current" once it scrolls above the reading line (see update()).
   * Runs for every list on the page (sidebar and mobile versions).
   */
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  ]
  const ids = [...new Set(links.map((link) => link.dataset.tocLink!))]
  const headings = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null)

  /*
   * A clicked section stays highlighted even if the page can't scroll far
   * enough to bring it to the top (short sections near the end), until the
   * visitor scrolls by themselves.
   */
  let clickedId: string | null = null
  for (const link of links) {
    link.addEventListener("click", () => {
      clickedId = link.dataset.tocLink!
      schedule()
    })
  }
  for (const type of ["wheel", "touchmove", "keydown", "pointerdown"]) {
    window.addEventListener(type, () => (clickedId = null), { passive: true })
  }

  function update() {
    if (clickedId) return highlight(clickedId)

    /*
     * The "reading line": a quarter of the way down the part of the screen
     * not covered by the floating header. Once the next heading rises above
     * it, that section is what you're reading, even though the header still
     * hides the last lines of the previous one. Jumping to a heading from
     * the contents puts it at scroll-padding-top, safely above this line.
     */
    const headerBottom = parseFloat(
      getComputedStyle(document.documentElement).scrollPaddingTop,
    )
    const offset = headerBottom + (window.innerHeight - headerBottom) * 0.25
    const atBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2

    let current = atBottom ? headings.at(-1) : undefined
    if (!current) {
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > offset) break
        current = heading
      }
    }

    highlight(current?.id)
  }

  function highlight(id: string | undefined) {
    for (const link of links) {
      if (link.dataset.tocLink === id) {
        if (!link.hasAttribute("aria-current")) keepInView(link)
        link.setAttribute("aria-current", "location")
      } else {
        link.removeAttribute("aria-current")
      }
    }
  }

  /*
   * A long list scrolls inside the sidebar (with its scrollbar hidden), so
   * scroll it just enough to keep the highlighted section visible. Only the
   * sidebar moves; scrollIntoView() would scroll the whole page as well.
   */
  function keepInView(link: HTMLElement) {
    const box = link.closest<HTMLElement>("aside")
    if (!box || box.scrollHeight <= box.clientHeight) return

    const margin = 32
    const linkTop = link.getBoundingClientRect().top
    const boxTop = box.getBoundingClientRect().top
    const top = linkTop - boxTop + box.scrollTop

    if (top - margin < box.scrollTop) {
      box.scrollTo({ top: top - margin })
    } else {
      const bottom = top + link.offsetHeight + margin
      if (bottom > box.scrollTop + box.clientHeight) {
        box.scrollTo({ top: bottom - box.clientHeight })
      }
    }
  }

  let frame = 0
  const schedule = () => {
    cancelAnimationFrame(frame)
    frame = requestAnimationFrame(update)
  }

  if (headings.length > 0) {
    update()
    window.addEventListener("scroll", schedule, { passive: true })
    window.addEventListener("resize", schedule)
  }
</script>
