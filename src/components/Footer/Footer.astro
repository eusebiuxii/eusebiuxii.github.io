---
import { cn } from "@/lib/utils"
import { site } from "@/site.config"
import styles from "./Footer.module.css"

const year = new Date().getFullYear()
---

<footer id="contact" class={styles.footer}>
  <div class={cn("container", styles.inner)}>
    <p>© {year} {site.name}</p>
    <ul class={styles.links}>
      {/* Hidden until the script below builds its mailto: link */}
      <li hidden data-email-item>
        <a
          data-email-user={site.email.user}
          data-email-domain={site.email.domain}>Email</a
        >
      </li>
      {
        site.socials.map((link) => (
          <li>
            <a href={link.href} rel="me noopener" target="_blank">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<script>
  /*
   * Joins the email address in the browser. Scrapers that read the raw HTML
   * never see it, while visitors get a normal link to their mail app.
   */
  const link = document.querySelector<HTMLAnchorElement>("[data-email-user]")
  const item = document.querySelector<HTMLElement>("[data-email-item]")
  if (link && item) {
    const { emailUser, emailDomain } = link.dataset
    link.href = `mailto:${emailUser}@${emailDomain}`
    item.hidden = false
  }
</script>
